# --- Supabase (get these from your Supabase project: Settings -> API) ---
# Client-safe project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Client-safe anon/public key. RLS is what actually protects data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Used for privileged share-resolution / signed URLs. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- App ---
# Public base URL used to build share links (no trailing slash).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- OpenAI (optional AI writing assistance, P2) ---
# Server-only. Leave blank to disable AI features.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
