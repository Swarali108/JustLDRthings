# --- Supabase (get these from your Supabase project: Settings -> API) ---
# Client-safe project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Client-safe anon/public key. RLS is what actually protects data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Used for privileged share-resolution / signed URLs. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- App ---
# Public base URL used to build share links (no trailing slash).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- AI (optional: writing help + AI mixtape) ---
# Server-only. Leave blank to disable the AI features; everything else still works.
# Works with an OpenAI key (sk-...) or an OpenRouter key (sk-or-v1-...): the
# endpoint is chosen from the key prefix, so you usually need nothing else.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Only needed to override that choice, e.g. a proxy or a different gateway:
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
